<odoo>
    <record id="view_truk_belanja_wizard" model="ir.ui.view">
        <field name="name">truk.belanja.wizard.form</field>
        <field name="model">truk.belanja.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Truk Belanja">
                <group>
                    <field name="sale_order_ids" widget="many2many_tags"/>
                    <field name="driver_id"/>
                </group>

                <footer>
                    <button name="action_print" type="object"
                            string="Print" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_truk_belanja_wizard" model="ir.actions.act_window">
        <field name="name">Print Truk Belanja</field>
        <field name="res_model">truk.belanja.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
