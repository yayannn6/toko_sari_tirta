<odoo>
  <template id="report_receipt_sale">
      <t t-call="web.html_container">

        <script>
          window.onload = function() {
            window.print(); 
          }
        </script>

        <style>
          @font-face {
            font-family: 'LiberationSerifCustom';
            src: url('/custom_invoice_receipt/static/src/fonts/LiberationSerif-Regular.ttf') format('truetype');
            }
            .receipt-font {
              font-family: 'LiberationSerifCustom', serif;
            }
        </style>        

        <t t-foreach="docs" t-as="so">
          <t t-set="company" t-value="so.company_id"/>

          <!-- ⬇️ HANYA line-height dinaikkan -->
          <div class="receipt-font" style="width:210px; font-size:14px; line-height:1;">

            <!-- HEADER COMPANY INFO -->
            <div style="text-align:center; margin-bottom:4px;">
              <t t-if="company.logo">
                <img t-att-src="'data:image/png;base64,%s' % company.logo.decode('utf-8')" width="55" style="margin-bottom:4px;"/>
              </t>

              <h5 style="font-weight:700;">
                <t t-esc="company.name"/>
              </h5>

              <p style="font-size:13px;font-weight:550;margin:1px"><t t-esc="company.street or ''"/></p>
              <p style="font-size:13px;font-weight:550;margin:1px"><t t-esc="company.phone or ''"/></p>
              <p style="font-size:13px;font-weight:550;margin:1px"><t t-esc="company.website or ''"/></p>

              <p style="margin:4px 0;">---------------------------</p>
            </div>

            <!-- INFO -->
            <p style="font-size:13px;font-weight:550;margin:1px">No: <t t-esc="so.name"/></p>
            <p style="font-size:13px;font-weight:550;margin:1px">Tanggal: <t t-esc="so.date_order.strftime('%d-%m-%Y')"/></p>
            <p style="font-size:13px;font-weight:550;margin:1px">Pelanggan: <t t-esc="so.partner_id.name"/></p>

            <p style="margin:4px 0;">---------------------------</p>

            <!-- ITEM LIST -->
            <table style="width:100%; border:0; font-size:14px; line-height:1.1;font-weight:550">
              <t t-foreach="so.order_line" t-as="line">

                <tr style="margin:1px">
                  <td colspan="3" style="padding:1px 0">
                    <t t-esc="line.product_id.name"/>
                  </td>
                </tr>

                <tr style="margin:1px">
                  <td style="padding:1px 0;">
                    <t t-esc="int(line.product_uom_qty)"/> x
                    <t t-esc="'Rp {:,.0f}'.format(line.price_unit)"/>
                  </td>

                  <!-- DISKON -->
                  <t t-if="line.discount_amount &gt; 0">
                    <td style="font-size:12px; color:#444; padding:1px 0;">
                      - <t t-esc="'{:,.0f}'.format(line.discount_amount)"/>
                    </td>
                  </t>
                  <t t-else="">
                    <td style="font-size:12px; padding:1px 0;"/>
                  </t>

                  <td style="text-align:right; padding:1px 0;font-size:14px">
                    <t t-esc="'Rp {:,.0f}'.format(line.price_subtotal)"/>
                  </td>
                </tr>
                <tr>
                  <td colspan="3" style="padding:5px 0">
                  </td>
                </tr>

              </t>
            </table>

            <p style="margin:4px 0;">---------------------------</p>

            <p style="margin:4px 0;font-size:14px;font-weight:550">
              Diskon:
              <span style="float:right; white-space:nowrap; display:inline-block;">
                Rp <t t-esc="'{:,.0f}'.format(so.total_discount_amount)"/>
              </span>
            </p>
            <!-- TOTAL -->
            <p style="margin:4px 0;font-size:14px;font-weight:550">
              Total:
              <span style="float:right; white-space:nowrap; display:inline-block;">
                Rp <t t-esc="'{:,.0f}'.format(so.amount_total)"/>
              </span>
            </p>

            <p style="text-align:center; margin:4px 0;">---------------------------</p>

            <!-- FOOTER -->
            <div style="text-align:center;;font-weight:550">
              <p style="margin:4px 0;font-size:13px">Terima kasih!</p>
              <p style="margin:4px 0;">---------------------------</p>
              <p style="margin:4px 0; font-size:13px;">
                Dicetak pada <t t-esc="so.create_date.strftime('%d-%m-%Y')"/>
              </p>
            </div>

          </div>
        </t>

      </t>
  </template>
</odoo>
