<odoo>
    <template id="truk_belanja_template">
        <t t-call="web.html_container">

            <script>
                window.onload = function() {
                    window.print(); 
                }
            </script>
            <style>
                @font-face {
                    font-family: 'LiberationSerifCustom';
                    src: url('/custom_invoice_receipt/static/src/fonts/LiberationSerif-Regular.ttf') format('truetype');
                }
                .receipt-font {
                    font-family: 'LiberationSerifCustom', serif;
                }
            </style>

            <!-- ⬇️ line-height sedikit dinaikkan -->
            <div class="receipt-font" style="width:210px; font-size:14px; line-height:1.45; font-weight:600;">

                <!-- HEADER DRIVER -->
                <div style="margin-bottom:12px;">
                    <p style="margin:4px 0;">
                        <strong>Driver:</strong>
                        <span t-esc="driver_name"/>
                    </p>
                </div>

                <!-- TITLE -->
                <h5 style="text-align:center; margin:4px 0; padding:0;font-weight:700;">
                    DAFTAR BARANG
                </h5>
                <hr style="margin:8px 0;"/>

                <!-- TABLE BARANG -->
                <table style="width:100%; border-collapse:collapse; font-size:14px; line-height:1.45;">
                    <thead>
                        <tr style="background:#f8f8f8; border-bottom:1px solid #ccc;">
                            <th style="padding:7px 4px; text-align:left;">Barang</th>
                            <th style="padding:7px 4px; text-align:right; width:60px;">Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lines" t-as="line">
                            <tr>
                                <td style="padding:6px 4px; border-bottom:1px solid #eee;">
                                    <t t-esc="line['product_name']"/>
                                </td>
                                <td style="padding:6px 4px; text-align:right; border-bottom:1px solid #eee;">
                                    <t t-esc="line['qty']"/> Box
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- TOTALS -->
                <hr style="margin:12px 0;"/>

                <div style="margin-bottom:10px;">
                    <p style="margin:4px 0;">
                        <strong>Total Quantity:</strong>
                        <span t-esc="int(total_qty)"/>
                    </p>
                    <p style="margin:4px 0;">
                        <strong>Total Berat:</strong>
                        <span t-esc="total_weight"/> kg
                    </p>
                    <p style="margin:4px 0;">
                        <strong>Total Harga:</strong>
                        <t t-esc="'Rp {:,.0f}'.format(total_price)"/>
                    </p>
                </div>

                <!-- SALES ORDER LIST -->
                <div style="margin-top:12px;">
                    <p style="margin:4px 0;">
                        <strong>Total SO:</strong>
                        <span t-esc="int(total_so)"/>
                    </p>

                    <p style="margin:4px 0;">
                        <strong>Daftar SO:</strong>
                    </p>
                    <ul style="margin:4px 0; padding-left:20px;">
                        <t t-foreach="so_names" t-as="so">
                            <li style="margin:3px 0;" t-esc="so"/>
                        </t>
                    </ul>
                </div>

            </div>
        </t>
    </template>
</odoo>
